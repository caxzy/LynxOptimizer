<Window x:Class="LynxUi.AppVersion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verification" Height="180" Width="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Border Background="#18181A" CornerRadius="12" BorderBrush="#2D2D32" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="StatusText" Text="Checking Lynx Version..." 
                       Foreground="#E0E0E0" FontSize="14" TextWrapping="Wrap" 
                       VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>

            <StackPanel x:Name="ButtonsPanel" Grid.Row="1" Orientation="Horizontal" 
                        HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,10,0,0">
                <Button Content="Yes" Width="90" Height="32" Margin="0,0,10,0" 
                        Background="#323238" Foreground="#FFFFFF" BorderThickness="0" Click="YesButton_Click"/>
                <Button Content="No" Width="90" Height="32" 
                        Background="#323238" Foreground="#FFFFFF" BorderThickness="0" Click="NoButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>